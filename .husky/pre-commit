echo "🔍 Running pre-commit quality checks..."

# Format and lint the files being committed. Linting only staged files keeps
# old findings elsewhere in the repo from blocking unrelated commits.
echo "📝 Formatting and linting staged files..."
npx lint-staged

# Run tests to ensure nothing broke
echo "🧪 Running tests..."
npm test -- --passWithNoTests

echo "✅ Pre-commit checks passed!"

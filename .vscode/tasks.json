{
  "version": "2.0.0",
  "windows": {
    "options": {
      "shell": {
        "executable": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
        "args": ["--login", "-c"]
      }
    }
  },
  "tasks": [
    {
      "label": "🚀 Start Development Server",
      "type": "shell",
      "command": "npm run dev",
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "🔨 Build Production",
      "type": "shell",
      "command": "npm run build",
      "problemMatcher": ["$eslint-stylish"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "🧪 Run All Tests",
      "type": "shell",
      "command": "npm test",
      "problemMatcher": ["$eslint-stylish"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "👀 Run Tests (Watch Mode)",
      "type": "shell",
      "command": "npm run test:watch",
      "problemMatcher": [],
      "isBackground": true,
      "group": {
        "kind": "test",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated"
      }
    },
    {
      "label": "🔍 Lint Code",
      "type": "shell",
      "command": "npm run lint",
      "problemMatcher": ["$eslint-stylish"],
      "group": "none",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "🔧 Lint & Fix",
      "type": "shell",
      "command": "npm run lint:fix",
      "problemMatcher": ["$eslint-stylish"],
      "group": "none",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "💅 Format Code",
      "type": "shell",
      "command": "npm run format",
      "problemMatcher": [],
      "group": "none",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "✅ Full Quality Check",
      "type": "shell",
      "command": "npx eslint . && npm run format && npm test",
      "problemMatcher": ["$eslint-stylish"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      },
      "options": {
        "shell": {
          "executable": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
          "args": ["--login", "-c"]
        }
      }
    },
    {
      "label": "🔄 Clean & Reinstall Dependencies",
      "type": "shell",
      "command": "rm -rf node_modules .next package-lock.json && npm install",
      "problemMatcher": [],
      "group": "none",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "💾 Create Backup",
      "type": "shell",
      "command": "powershell.exe -ExecutionPolicy Bypass -File ./backup-repo.ps1",
      "problemMatcher": [],
      "group": "none",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "📊 Check Bundle Size",
      "type": "shell",
      "command": "npm run build && du -sh .next",
      "problemMatcher": [],
      "group": "none",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "🔐 Security Audit",
      "type": "shell",
      "command": "npm audit",
      "problemMatcher": [],
      "group": "none",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "🎯 Pre-Commit Check (AI Recommended)",
      "type": "shell",
      "command": "npm run lint:fix && npm run format && npm test && npm run build",
      "problemMatcher": ["$eslint-stylish"],
      "group": "none",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    }
  ]
}

# EditorConfig for ZionSync
# Ensures consistent coding styles across different editors and IDEs
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{js,jsx,mjs}]
indent_size = 2

[*.json]
indent_size = 2

[*.yml]
indent_size = 2

[package.json]
indent_size = 2

[*.css]
indent_size = 2
